# Copy to .env.local and fill in. Every variable is optional: without any of them the app
# runs in demo mode with fictional sample data stored only in the browser.

# Public site URL (https), used for metadata. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Public https URL of the OpportunityLens app on Amazon PartyRock (opened in a new tab).
# Example: https://partyrock.aws/u/<user>/<app-id>/<app-name>
NEXT_PUBLIC_PARTYROCK_FLOW_URL=

# --- P1: Supabase (not used by the app yet; demo mode stays active until the Supabase repository ships) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by admin scripts and seeding. Never prefix with NEXT_PUBLIC_ and never import from client code.
SUPABASE_SERVICE_ROLE_KEY=
